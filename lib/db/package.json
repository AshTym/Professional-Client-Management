{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "preflight:memberships": "node ./scripts/check-duplicate-memberships.mjs",
    "push": "pnpm run preflight:memberships && drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "pnpm run preflight:memberships && drizzle-kit push --force --config ./drizzle.config.ts",
    "test:preflight": "node ./scripts/test-duplicate-membership-preflight.mjs"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10"
  }
}
